# Copy to .env.local for local development (never commit .env.local). On Vercel, set these in
# Project Settings > Environment Variables. Only the server reads them; nothing here reaches the browser.

# Anthropic API key (console.anthropic.com). API usage is billed separately from any Claude.ai subscription.
ANTHROPIC_API_KEY=

# Model ids. Confirm in the Anthropic docs "Models overview" page before use.
# Suggested (current as of 2026-10): MODEL_EXTRACT=claude-haiku-5-5 (cheaper; reads PDFs/photos)
#                                    MODEL_REASON=claude-opus-5-5  (clinical check + debate; claude-sonnet-5-5 is cheaper)
MODEL_EXTRACT=
MODEL_REASON=

# Live (paid) calls happen ONLY when this is exactly 0. Unset or 1 = cache-only: sample bills replay
# from /cache and uploads are switched off. Keep 1 for a public demo.
KANAKKU_CACHE_ONLY=1

# Spend guard (all optional; these are the defaults). In-memory per server instance, so ALSO set a
# monthly spend limit in the Anthropic Console: that is the hard cap.
KANAKKU_MAX_CALLS_PER_RUN=45
KANAKKU_MAX_TOKENS_PER_RUN=250000
KANAKKU_MAX_TOKENS_PER_DAY=2000000
KANAKKU_MAX_RUNS_PER_HOUR=3
KANAKKU_MAX_OUTPUT_TOKENS=4000
KANAKKU_TIMEOUT_MS=60000
KANAKKU_MAX_DEBATE_FINDINGS=12

# Upload limits. Vercel's request body limit is about 4.5 MB (verify for your plan).
KANAKKU_MAX_UPLOAD_MB=4
KANAKKU_MAX_PDF_PAGES=8
